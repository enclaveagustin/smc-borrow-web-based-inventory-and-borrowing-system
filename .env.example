# HulamKo - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# DATABASE CONFIGURATION
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hulam_ko
DB_PORT=3306

# FLASK BACKEND
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=hulam-ko-dev-secret-key-2026
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# APPLICATION SETTINGS
APP_NAME=HulamKo
APP_VERSION=1.0.0
APP_TITLE=HulamKo - Inventory & Lending Management

# FRONTEND URL
FRONTEND_URL=http://localhost:8080
BACKEND_API_URL=http://localhost:5000/api

# HTTP SERVER (for frontend)
HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=8080
HTTP_SERVER_DIR=frontend

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=hulam_ko.log

# CORS SETTINGS
CORS_ORIGINS=*

# SESSION
SESSION_TIMEOUT=3600
REMEMBER_ME_DURATION=604800

# EMAIL CONFIGURATION (Gmail SMTP)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (NOT your regular Gmail password)
EMAIL_SENDER=your-email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
